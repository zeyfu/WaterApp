{
  "expo": {
    "name": "Beba+",
    "slug": "watter-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "watterapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B7D0F5",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rick.waterapp",
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#B7D0F5",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "icon": "./assets/images/logo.png",
          "iosUrlScheme": "com.googleusercontent.apps.57277302927-j3cu22pu9vmr8bb4cqkie86plcklhus7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9e223ab-b641-45b5-8018-8aa9988851bf"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f9e223ab-b641-45b5-8018-8aa9988851bf"
    }
  }
}